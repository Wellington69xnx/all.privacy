{
  "name": "cinema-nova-mvp",
  "version": "1.0.0",
  "description": "Website MVP para conteúdo de atrizes usando Node.js e Tailwind CSS.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "tailwind:build": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "super-dev": "concurrently \"npm run dev\" \"npm run tailwind:build\""
  },
  "keywords": [
    "node",
    "express",
    "tailwind",
    "ejs",
    "mvp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6"
  }
}
