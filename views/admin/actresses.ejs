<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 space-y-4 sm:space-y-0">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-200">Gerenciamento de Atrizes & Conteúdo</h2>
    
    <a href="/admin/actresses/add" 
       class="w-full sm:w-auto px-5 py-2 bg-orange-600 text-white font-semibold rounded-lg shadow-md hover:bg-orange-700 transition duration-200 flex items-center justify-center space-x-2 text-sm sm:text-base">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        <span>Adicionar Nova Atriz</span>
    </a>
</div>

<div class="bg-gray-800 rounded-xl shadow-lg">

    <% if (actresses && actresses.length > 0) { %>
        
        <div class="hidden md:block overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-700">
                <thead class="bg-gray-700">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider w-1/3">
                            Atriz
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider w-1/4">
                            Foto de Capa (URL)
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider w-1/4">
                            Ações
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-700">
                    
                    <% actresses.forEach(actress => { %>
                    <tr class="hover:bg-gray-700 transition duration-150">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-white flex items-center space-x-3">
                            <img src="<%= actress.profilePhotoUrl %>" alt="Perfil" class="w-10 h-10 object-cover rounded-full border-2 border-orange-500">
                            <span><%= actress.name %></span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                             <span class="truncate block w-40 text-xs text-gray-400" title="<%= actress.coverPhotoUrl %>">
                                <%= actress.coverPhotoUrl.length > 30 ? actress.coverPhotoUrl.substring(0, 27) + '...' : actress.coverPhotoUrl %>
                            </span>
                        </td>
                        
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                            
                            <a href="/admin/actresses/<%= actress.slug %>/videos" title="Gerenciar Conteúdo" 
                               class="inline-flex items-center px-2 py-1 border border-orange-500 rounded-lg text-orange-400 hover:bg-orange-500 hover:text-white transition duration-150">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2zM12 17v-6m-3 3h6"></path></svg>
                            </a>
                            
                            <a href="/admin/actresses/edit/<%= actress.slug %>" title="Editar Perfil"
                               class="inline-flex items-center px-2 py-1 border border-blue-500 rounded-lg text-blue-400 hover:bg-blue-500 hover:text-white transition duration-150">
                               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            </a>
                            
                            <button onclick="confirmDelete('<%= actress.slug %>', '<%= actress.name %>')" title="Deletar Atriz"
                               class="inline-flex items-center px-2 py-1 border border-red-500 rounded-lg text-red-400 hover:bg-red-500 hover:text-white transition duration-150">
                               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>

                            <form id="delete-form-<%= actress.slug %>" method="POST" action="/admin/actresses/delete/<%= actress.slug %>" style="display:none;"></form>

                        </td>
                    </tr>
                    <% }) %>
                    </tbody>
            </table>
        </div>
        
        <div class="md:hidden p-4 space-y-4">
            
            <% actresses.forEach(actress => { %>
            <div class="bg-gray-700/70 p-4 rounded-lg border-l-4 border-orange-500 shadow-md">
                <div class="flex justify-between items-start mb-2">
                    <p class="text-lg font-bold text-white"><%= actress.name %></p>
                </div>
                
                <div class="text-sm space-y-1 mb-3 flex items-center space-x-3">
                     <img src="<%= actress.profilePhotoUrl %>" alt="Perfil" class="w-10 h-10 object-cover rounded-full border-2 border-orange-500">
                    <p class="text-gray-400">ID: <span class="text-gray-200 font-medium"><%= actress._id %></span></p>
                </div>
                
                <div class="pt-3 border-t border-gray-600 flex flex-wrap gap-3 text-sm font-medium">
                    <a href="/admin/actresses/<%= actress.slug %>/videos" class="text-orange-400 hover:text-orange-500 underline">Gerenciar Conteúdo</a>
                    <a href="/admin/actresses/edit/<%= actress.slug %>" class="text-blue-400 hover:text-blue-500 underline">Editar</a>
                    <button onclick="confirmDelete('<%= actress.slug %>', '<%= actress.name %>')" class="text-red-400 hover:text-red-500 underline">Excluir</button>
                </div>
                <form id="delete-form-mobile-<%= actress.slug %>" method="POST" action="/admin/actresses/delete/<%= actress.slug %>" style="display:none;"></form>
            </div>
            <% }) %>
            </div>
        
    <% } else { %>
        <div class="p-6 text-center text-gray-400">
            <p class="mb-4">Nenhuma atriz encontrada. Comece a gerenciar seu portal!</p>
            <a href="/admin/actresses/add" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition duration-200 font-semibold">
                Adicionar Primeira Atriz
            </a>
        </div>
    <% } %>

</div>


<script>
    function confirmDelete(slug, name) {
        // Primeira Confirmação (Alerta Básico)
        if (confirm(`ATENÇÃO: Você está prestes a excluir a atriz "${name}" e todos os seus arquivos.\n\nTem certeza que deseja continuar?`)) {
            
            // Segunda Confirmação (Alerta de Segurança Final)
            if (confirm(`CONFIRMAÇÃO FINAL: Se você excluir "${name}", os dados serão perdidos permanentemente. \n\nPressione OK para DELETAR ou Cancelar para manter.`)) {
                
                // Se a confirmação dupla for bem-sucedida, submete o formulário
                const form = document.getElementById(`delete-form-${slug}`) || document.getElementById(`delete-form-mobile-${slug}`);
                if (form) {
                    form.submit();
                } else {
                    alert('Erro: Formulário de exclusão não encontrado.');
                }
            } else {
                // Usuário cancelou no segundo alerta
                alert('A exclusão foi cancelada.');
            }
        } else {
            // Usuário cancelou no primeiro alerta
            alert('A exclusão foi cancelada.');
        }
    }
</script>