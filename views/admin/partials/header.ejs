<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-900 text-white font-sans flex min-h-screen">

    <aside class="w-64 bg-gray-800 border-r border-gray-700 flex flex-col fixed top-0 left-0 h-screen z-40 
              transform -translate-x-full md:translate-x-0 md:static transition-transform duration-300 ease-in-out" 
       id="sidebar">

        <div class="p-6 border-b border-gray-700 flex justify-between items-center">
            <h2 class="text-2xl font-extrabold tracking-wider">
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-400 to-amber-300">
                    AllPrivacy
                </span>
                <span class="text-gray-400 text-sm block leading-none">Admin Panel</span>
            </h2>
            <button id="sidebar-close" onclick="toggleSidebar()" class="text-gray-400 hover:text-orange-500 md:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <nav class="flex-grow p-4 space-y-2 overflow-y-auto"> 

            <% 
                const currentPath = title.includes('Dashboard') ? '/admin/dashboard' : 
                                    title.includes('Atriz') ? '/admin/actresses' : 
                                    title.includes('Assinaturas') ? '/admin/subscriptions' : 
                                    title.includes('Configurações') ? '/admin/settings' : '';

                const activeClasses = 'bg-orange-600/20 text-orange-400 font-semibold hover:bg-orange-700/30';
                const inactiveClasses = 'text-gray-300 hover:bg-gray-700'; 
            %>

            <a href="/admin/dashboard" 
               class="flex items-center space-x-3 p-3 rounded-lg transition duration-200 
               <%= currentPath === '/admin/dashboard' ? activeClasses : inactiveClasses %>">
                <svg class="w-5 h-5 <%= currentPath === '/admin/dashboard' ? 'text-orange-400' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l-2 2m-2-2v10a1 1 0 01-1 1h-3"></path></svg>
                <span>Dashboard</span>
            </a>

            <a href="/admin/actresses" 
               class="flex items-center space-x-3 p-3 rounded-lg transition duration-200 
               <%= currentPath === '/admin/actresses' ? activeClasses : inactiveClasses %>">
                <svg class="w-5 h-5 <%= currentPath === '/admin/actresses' ? 'text-orange-400' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <span>Atrizes & Conteúdo</span>
            </a>

            <a href="/admin/subscriptions" 
               class="flex items-center space-x-3 p-3 rounded-lg transition duration-200 
               <%= currentPath === '/admin/subscriptions' ? activeClasses : inactiveClasses %>">
                <svg class="w-5 h-5 <%= currentPath === '/admin/subscriptions' ? 'text-orange-400' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 7v-1m-1.999-3H10m2 0h2m-2-4v.01"></path></svg>
                <span>Assinaturas</span>
            </a>

            <a href="/admin/settings" 
               class="flex items-center space-x-3 p-3 rounded-lg transition duration-200 
               <%= currentPath === '/admin/settings' ? activeClasses : inactiveClasses %>">
                <svg class="w-5 h-5 <%= currentPath === '/admin/settings' ? 'text-orange-400' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35-.426.426-.63 1.077-.426 1.756s.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.94 1.543-.826 3.31 2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35.426-.426.63-1.077.426-1.756s-.826-3.31 2.37-2.37a1.724 1.724 0 002.572-1.065z"></path></svg>
                <span>Configurações</span>
            </a>

        </nav>

        <div class="p-4 border-t border-gray-700 mt-auto">
            <a href="/admin/login" class="flex items-center space-x-3 p-3 rounded-lg text-red-400 transition duration-200 hover:bg-gray-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3v-1M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3v-1"></path></svg>
                <span>Sair</span>
            </a>
        </div>
    </aside>

    <div class="flex-grow md:ml-0 md:pl-64"> 
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 hidden md:hidden" onclick="toggleSidebar()"></div>

        <header class="sticky top-0 z-30 bg-gray-900 border-b border-gray-700 px-6 py-4 flex justify-between items-center">

            <div class="flex items-center space-x-4">
                <button id="sidebar-toggle" class="text-gray-400 hover:text-orange-500 md:hidden p-1">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h1 class="text-2xl font-bold text-gray-200">
                    <%= title.split('|')[0].trim() %>
                </h1>
            </div>

            <div class="flex items-center space-x-3">
                <span class="text-sm text-gray-400 hidden sm:block">Olá, Administrador!</span>
                <div class="w-10 h-10 rounded-full bg-orange-600 flex items-center justify-center text-sm font-bold">A</div>
            </div>
        </header>

        <main class="p-6">