<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-950 text-white min-h-screen font-sans flex items-center justify-center p-4">

    <div class="w-full max-w-md bg-gray-900 p-8 md:p-10 rounded-xl shadow-2xl border border-orange-500/20">
        <h1 class="text-3xl font-black text-center mb-6">
             <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-500 to-amber-400">
                Nova Senha
            </span>
        </h1>

        <% if (error) { %>
            <div class="bg-red-900 border border-red-700 text-white p-3 rounded mb-4 text-sm text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/reset-password/<%= token %>" method="POST" class="space-y-6">
            
            <div>
                <label for="password" class="block text-sm font-medium text-gray-300">Nova Senha (mín. 8 caracteres)</label>
                <input type="password" id="password" name="password" required minlength="8"
                       class="mt-1 block w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-orange-500 focus:border-orange-500 placeholder-gray-500"
                       placeholder="••••••••">
            </div>

            <div>
                <label for="confirm_password" class="block text-sm font-medium text-gray-300">Confirme a Nova Senha</label>
                <input type="password" id="confirm_password" name="confirm_password" required minlength="8"
                       class="mt-1 block w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-orange-500 focus:border-orange-500 placeholder-gray-500"
                       placeholder="••••••••">
            </div>

            <button type="submit" 
                    class="w-full py-3 px-4 text-lg font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition duration-300 shadow-md shadow-orange-500/50">
                Redefinir
            </button>
        </form>
    </div>

</body>
</html>