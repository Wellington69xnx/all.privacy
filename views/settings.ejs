// views/settings.ejs
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-black text-white min-h-screen font-sans flex flex-col">
    
<%- include('partials/header.ejs', { user: user }) %>

    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
        
        <h1 class="text-4xl font-black mb-6">
             <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-500 to-amber-400">
                Configurações da Conta
            </span>
        </h1>

        <% 
            // O erro de unicidade do nome de usuário não será mais exibido localmente.
            const isUsernameError = error_msg && (error_msg.includes('Este nome de usuário já está em uso') || error_msg.includes('Nome de usuário indisponível'));
            const generalError = error_msg; // Todos os erros vão para a área geral
        %>
        
        <% if (success_msg) { %>
            <div class="bg-green-900 border border-green-700 text-white p-3 rounded mb-4 text-sm">
                <%= success_msg %>
            </div>
        <% } %>
        <% if (generalError) { %>
            <div class="bg-red-900 border border-red-700 text-white p-3 rounded mb-4 text-sm">
                <%= error_msg %>
            </div>
        <% } %>

        <div class="bg-gray-900 p-8 rounded-xl shadow-xl border-t-4 border-orange-500 space-y-10">
            
            <div>
                <h2 class="text-2xl font-semibold mb-4 text-gray-200 border-b border-gray-700 pb-2">Foto de Perfil</h2>
                
                <div class="flex flex-col md:flex-row md:items-start items-center gap-6 max-w-xl">
                    
                    <div class="flex flex-col items-center space-y-3 flex-shrink-0">
                        <div id="current-avatar-wrapper" class="w-28 h-28 rounded-full bg-orange-600 flex items-center justify-center text-5xl font-bold uppercase shadow-lg overflow-hidden border-2 border-orange-500">
                            <% if (user.profilePhotoUrl) { %>
                                <img src="<%= user.profilePhotoUrl %>" alt="Foto de Perfil" id="profile-preview-img" class="w-full h-full object-cover">
                            <% } else if (user.username) { %>
                                <span id="profile-initials"><%= user.username.charAt(0).toUpperCase() %></span>
                            <% } else { %>
                                <span id="profile-initials">U</span>
                            <% } %>
                        </div>
                        
                        <% if (user.profilePhotoUrl) { %>
                            <button type="button" onclick="showConfirmModal('photo')" class="px-3 py-1 text-xs font-semibold rounded-lg bg-red-700 hover:bg-red-800 text-white transition">
                                Remover Foto
                            </button>
                        <% } %>
                    </div>
                    
                    <div class="flex flex-col w-full space-y-4 pt-2 md:pt-0">
                        <form action="/settings/profile-photo" method="POST" enctype="multipart/form-data" id="profile-photo-form" class="space-y-4">
                            
                            <label class="block w-full">
                                <span class="text-sm text-gray-400 block mb-1">Selecione uma nova imagem (Máx. 5MB):</span>
                                <input type="file" name="profilePhoto" id="profile-photo-input" required
                                       class="block w-full text-sm text-gray-500
                                              file:mr-4 file:py-2 file:px-4
                                              file:rounded-full file:border-0
                                              file:text-sm file:font-semibold
                                              file:bg-orange-50 file:text-orange-700
                                              hover:file:bg-orange-100 transition duration-300"
                                       accept="image/*"/>
                            </label>

                            <button type="submit" id="save-photo-btn" class="px-6 py-2 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition shadow-lg shadow-orange-500/50">
                                Salvar Nova Foto
                            </button>
                        </form>
                        <p class="mt-2 text-sm text-gray-500 hidden md:block">Clique em "Salvar Nova Foto" após selecionar a imagem acima para finalizar a alteração.</p>
                    </div>

                </div>
            </div>
            
            <div>
                <h2 class="text-2xl font-semibold mb-4 text-gray-200 border-b border-gray-700 pb-2">Informações Básicas</h2>

                <form action="/settings/profile" method="POST" id="profile-form" class="space-y-6">
                    
                    <div class="max-w-lg">
                        <label for="username" class="block text-sm font-medium text-gray-300">Nome de Usuário</label>
                        <div class="mt-1 flex">
                            <input type="text" id="username" name="username" required minlength="3"
                                   value="<%= user.username %>"
                                   data-original-value="<%= user.username %>"
                                   readonly 
                                   oninput="checkUsernameChange()"
                                   class="block w-full px-4 py-3 border border-gray-700 rounded-l-lg text-white focus:ring-orange-500 focus:border-orange-500 <%= user.username ? 'text-gray-400 bg-gray-800' : 'bg-gray-800' %>">
                            
                            <button type="button" id="edit-username-btn" onclick="toggleUsernameEdit(true)"
                                    class="flex items-center px-4 py-3 border border-l-0 border-gray-700 rounded-r-lg bg-gray-700 text-orange-400 hover:bg-gray-600 focus:z-10 focus:outline-none focus:ring-orange-500 focus:border-orange-500 transition duration-150">
                                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.647-2.658a4.5 4.5 0 011.13-1.897L16.862 4.487zm0 0L19.5 7.125" />
                                </svg>
                            </button>
                            
                            <button type="button" id="cancel-username-btn" onclick="toggleUsernameEdit(false)"
                                    class="hidden items-center px-4 py-3 border border-l-0 border-gray-700 rounded-r-lg bg-red-700 text-white hover:bg-red-600 focus:z-10 focus:outline-none focus:ring-red-500 focus:border-red-500 transition duration-150 ml-[-1px]">
                                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    
                    <div class="max-w-xs">
                        <button type="button" id="save-username-btn-main" onclick="showConfirmModal('username')" disabled
                                class="w-full px-6 py-2 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition shadow-lg shadow-orange-500/50 opacity-50 cursor-not-allowed">
                            Salvar Nome de Usuário
                        </button>
                    </div>

                    <div class="pt-4 border-t border-gray-700">
                        <label for="email" class="block text-sm font-medium text-gray-300">E-mail</label>
                        <input type="email" id="email" name="email" disabled 
                               value="<%= user.email %>"
                               class="mt-1 block w-full max-w-lg px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-gray-400"
                               title="O E-mail não pode ser alterado."/>
                    </div>
                    
                    <div>
                        <label for="dateOfBirth" class="block text-sm font-medium text-gray-300">Data de Nascimento</label>
                        <input type="text" id="dateOfBirth" name="dateOfBirth" disabled 
                               value="<%= user.dateOfBirth %>"
                               class="mt-1 block w-full max-w-lg px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-gray-400"
                               title="A data de nascimento não pode ser alterada."/>
                    </div>
                    
                </form>
            </div>

            <div>
                <h2 class="text-2xl font-semibold mb-4 text-gray-200 border-b border-gray-700 pb-2">Alterar Senha</h2>

                <form action="/settings/password" method="POST" class="space-y-6">
                    
                    <div>
                        <label for="current_password" class="block text-sm font-medium text-gray-300">Senha Atual</label>
                        <input type="password" id="current_password" name="current_password" required
                               class="mt-1 block w-full max-w-lg px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-orange-500 focus:border-orange-500"
                               placeholder="••••••••">
                    </div>

                    <div>
                        <label for="new_password" class="block text-sm font-medium text-gray-300">Nova Senha (Mín. 8 caracteres)</label>
                        <input type="password" id="new_password" name="new_password" required minlength="8"
                               class="mt-1 block w-full max-w-lg px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-orange-500 focus:border-orange-500"
                               placeholder="••••••••">
                    </div>
                    
                    <div>
                        <label for="confirm_new_password" class="block text-sm font-medium text-gray-300">Confirmar Nova Senha</label>
                        <input type="password" id="confirm_new_password" name="confirm_new_password" required minlength="8"
                               class="mt-1 block w-full max-w-lg px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:ring-orange-500 focus:border-orange-500"
                               placeholder="••••••••">
                    </div>

                    <button type="submit" class="px-6 py-2 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition shadow-lg shadow-orange-500/50">
                        Alterar Senha
                    </button>
                    
                    <p class="text-sm pt-2">
                        <a href="/forgot-password" class="text-orange-400 hover:text-orange-300 transition duration-150 underline">
                            Esqueceu sua senha atual? Clique aqui para redefinir.
                        </a>
                    </p>
                </form>
                
                <p class="mt-4 text-sm text-yellow-400">
                    *Atenção: A alteração de senha irá encerrar sua sessão e exigirá um novo login.
                </p>
            </div>
            
        </div>

    </main>
    
<%- include('partials/footer.ejs') %>

<form action="/settings/profile-photo/remove" method="POST" id="remove-photo-form" class="hidden"></form>


<div id="confirm-modal-username" 
     class="fixed inset-0 bg-black bg-opacity-75 z-[100] hidden flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="bg-gray-900 rounded-xl shadow-2xl w-full max-w-md p-6 transform transition-transform duration-300 scale-95">
        
        <div class="text-orange-500 mb-4 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.021 3.375 1.774 3.375h14.268c1.753 0 2.64-1.875 1.774-3.375l-7.133-12.493a1.75 1.75 0 00-1.547-1.125h-.002a1.75 1.75 0 00-1.547 1.125l-7.133 12.493z" />
            </svg>
        </div>
        
        <h3 class="text-xl font-bold text-white text-center mb-3">Confirmar Novo Nome de Usuário</h3>
        <p class="text-gray-400 text-center mb-6">
            Você está prestes a alterar seu nome de usuário para: <strong class="text-orange-300" id="new-username-display"></strong>.
        </p>
        
        <div class="flex justify-between space-x-4">
            <button type="button" onclick="closeConfirmModal('username')" 
                    class="flex-1 py-3 px-4 rounded-lg border border-gray-700 text-gray-300 hover:bg-gray-700 transition">
                Cancelar
            </button>
            <button type="button" onclick="submitProfileForm()"
                    class="flex-1 py-3 px-4 rounded-lg bg-orange-600 text-white font-semibold hover:bg-orange-700 transition shadow-md shadow-orange-500/30">
                Confirmar
            </button>
        </div>
    </div>
</div>

<div id="confirm-modal-photo-remove" 
     class="fixed inset-0 bg-black bg-opacity-75 z-[100] hidden flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="bg-gray-900 rounded-xl shadow-2xl w-full max-w-md p-6 transform transition-transform duration-300 scale-95">
        
        <div class="text-red-500 mb-4 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.021 3.375 1.774 3.375h14.268c1.753 0 2.64-1.875 1.774-3.375l-7.133-12.493a1.75 1.75 0 00-1.547-1.125h-.002a1.75 1.75 0 00-1.547 1.125l-7.133 12.493z" />
            </svg>
        </div>
        
        <h3 class="text-xl font-bold text-white text-center mb-3">Remover Foto de Perfil</h3>
        <p class="text-gray-400 text-center mb-6">
            Tem certeza que deseja remover sua foto de perfil? A imagem será apagada permanentemente do nosso sistema e você voltará a exibir sua inicial.
        </p>
        
        <div class="flex justify-between space-x-4">
            <button type="button" onclick="closeConfirmModal('photo')" 
                    class="flex-1 py-3 px-4 rounded-lg border border-gray-700 text-gray-300 hover:bg-gray-700 transition">
                Cancelar
            </button>
            <button type="button" onclick="submitRemovePhotoForm()"
                    class="flex-1 py-3 px-4 rounded-lg bg-red-700 text-white font-semibold hover:bg-red-800 transition shadow-md shadow-red-500/30">
                Remover Permanentemente
            </button>
        </div>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        const usernameInput = document.getElementById('username');
        const originalUsername = usernameInput.getAttribute('data-original-value');
        const saveUsernameBtn = document.getElementById('save-username-btn-main');
        const profilePhotoInput = document.getElementById('profile-photo-input');
        const avatarWrapper = document.getElementById('current-avatar-wrapper');

        // ==== RESTORED ELEMENTS ====
        const editUsernameBtn = document.getElementById('edit-username-btn');
        const cancelUsernameBtn = document.getElementById('cancel-username-btn');
        // ===========================

        // Inicializa o estado do botão ao carregar a página
        checkUsernameChange(); 

        // Adiciona listener para verificar mudanças no campo do nome de usuário
        usernameInput.addEventListener('input', checkUsernameChange);
        
        function checkUsernameChange() {
            const newUsername = usernameInput.value.trim();
            const isChanged = newUsername !== originalUsername.trim();
            const isValid = newUsername.length >= 3;
            
            // Toggle estado do botão
            if (isChanged && isValid) {
                saveUsernameBtn.disabled = false;
                // Remove opacidade e cursor restrito
                saveUsernameBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            } else {
                saveUsernameBtn.disabled = true;
                // Adiciona opacidade e cursor restrito
                saveUsernameBtn.classList.add('opacity-50', 'cursor-not-allowed');
            }
        }
    
        // ===================================
        // LÓGICA DE EDIÇÃO DO NOME DE USUÁRIO (Readonly Toggle)
        // ===================================
        window.toggleUsernameEdit = function(enable) {
            if (enable) {
                // Habilita edição
                usernameInput.readOnly = false;
                usernameInput.classList.remove('text-gray-400');
                usernameInput.focus();
                
                editUsernameBtn.classList.add('hidden');
                editUsernameBtn.classList.remove('flex');
                cancelUsernameBtn.classList.remove('hidden');
                cancelUsernameBtn.classList.add('flex');
            } else {
                // Restaura o valor original e desabilita edição
                usernameInput.value = originalUsername;
                usernameInput.readOnly = true;
                usernameInput.classList.add('text-gray-400');
                
                editUsernameBtn.classList.remove('hidden');
                editUsernameBtn.classList.add('flex');
                cancelUsernameBtn.classList.add('hidden');
                cancelUsernameBtn.classList.remove('flex');
            }
            // Recalcula o estado do botão
            checkUsernameChange();
        }


        // ===================================
        // LÓGICA GERAL DE MODAL
        // ===================================
        const modalUsername = document.getElementById('confirm-modal-username');
        const modalPhotoRemove = document.getElementById('confirm-modal-photo-remove');
        
        window.showConfirmModal = function(type) {
            if (type === 'username') {
                if (saveUsernameBtn.disabled) return;
                const newUsername = usernameInput.value.trim();
                
                if (!newUsername || newUsername.length < 3) {
                    alert('Por favor, digite um nome de usuário válido (mínimo 3 caracteres).');
                    return;
                }
                newUsernameDisplay.textContent = newUsername;
                modalUsername.classList.remove('hidden');
            } else if (type === 'photo') {
                modalPhotoRemove.classList.remove('hidden');
            }
             document.body.style.overflow = 'hidden'; // Evita scroll
        }
        
        window.closeConfirmModal = function(type) {
             if (type === 'username') {
                 modalUsername.classList.add('hidden');
             } else if (type === 'photo') {
                 modalPhotoRemove.classList.add('hidden');
             }
             document.body.style.overflow = ''; // Restaura scroll
        }
        
        // ===================================
        // LÓGICA DE SUBMISSÃO DE FORMULÁRIOS
        // ===================================
        const usernameForm = document.getElementById('profile-form');
        const removePhotoForm = document.getElementById('remove-photo-form');
        const newUsernameDisplay = document.getElementById('new-username-display');

        window.submitProfileForm = function() {
            usernameForm.submit();
            closeConfirmModal('username'); 
        }

        window.submitRemovePhotoForm = function() {
            if (removePhotoForm) {
                removePhotoForm.submit();
            }
            closeConfirmModal('photo'); 
        }
        

        // ===================================
        // LÓGICA DA PRÉ-VISUALIZAÇÃO DA FOTO
        // ===================================
        profilePhotoInput.addEventListener('change', function(event) {
            const file = event.target.files[0];
            
            if (file) {
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    let imgElement = document.getElementById('profile-preview-img');
                    let initialsSpan = document.getElementById('profile-initials');
                    
                    if (!imgElement) {
                        if (initialsSpan) {
                            avatarWrapper.removeChild(initialsSpan);
                        }
                        
                        imgElement = document.createElement('img');
                        imgElement.setAttribute('id', 'profile-preview-img');
                        imgElement.setAttribute('alt', 'Nova Foto de Perfil');
                        imgElement.className = 'w-full h-full object-cover';
                        
                        avatarWrapper.appendChild(imgElement);
                    } else if (initialsSpan) {
                         if (initialsSpan.parentNode) {
                             avatarWrapper.removeChild(initialsSpan);
                         }
                    }
                    
                    imgElement.src = e.target.result;
                };
                
                reader.readAsDataURL(file);
            }
        });
    });
</script>

</body>
</html>