<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css"> 
</head>
<body class="bg-black text-white min-h-screen font-sans m-0 p-0 overscroll-y-none">
    
<%- include('partials/header.ejs', { user: user }) %>

    <main id="hero-main" class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 text-center relative">
        
        <h1 class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter mb-6 leading-tight">
            Descubra o Universo das 
            <span class="bg-clip-text 
text-transparent bg-gradient-to-r from-orange-400 to-amber-300">
                Grandes Atrizes
            </span>
        </h1>
        
        <p class="text-xl sm:text-2xl text-gray-300 mb-10 max-w-4xl mx-auto">
            Portfólios exclusivos, biografias detalhadas e previews de conteúdo.
Seu portal para o talento feminino no cinema.
        </p>
        
        <a id="hero-cta" href="#previews" class="inline-block px-12 py-4 text-lg font-bold rounded-lg transition-all duration-300 transform 
            bg-orange-600 hover:bg-orange-700 shadow-lg shadow-orange-500/50 hover:shadow-xl hover:scale-[1.03]">
            Ver Destaques de Hoje →
        </a>
        
    </main>
    
    <section id="previews" class="container 
mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        <h2 class="text-4xl font-bold mb-10 text-center">
            Conteúdos em 
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-400 to-amber-300">
                Destaque
            </span>
        </h2>

        <div 
class="relative">
            
            <span id="scroll-indicator" class="md:hidden absolute top-1/2 right-4 -translate-y-1/2 z-20 
                text-sm font-light text-gray-400 text-shadow 
                transition duration-500 opacity-0 pointer-events-none">
                Deslize para ver mais →
         
   </span>

            <button id="scroll-left" onclick="scrollCards('left')" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 p-3 bg-black/70 hover:bg-black/90 rounded-full shadow-2xl hidden md:block border border-orange-500/30">
                <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            
            <div 
id="card-slider" class="flex space-x-6 pb-4 overflow-x-auto scroll-smooth snap-x snap-mandatory hide-scrollbar">
                
                <% for (let i = 1;
i <= 5; i++) { %>
                    <div class="flex-shrink-0 w-80 snap-center">
                        <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg shadow-gray-700/50 transform hover:scale-[1.03] transition duration-500 cursor-pointer">
                            
          
                            <div class="h-48 relative flex flex-col items-center justify-center 
                                         bg-gray-700 border-b-2 border-orange-600
                                
         bg-gradient-to-t from-gray-800 to-gray-700">
                                
                                <span class="absolute top-3 left-3 px-3 py-1 text-xs font-bold rounded-full bg-orange-600 text-white shadow-md">
              
                      VÍDEO
                                </span>
                                <svg class="w-12 h-12 text-orange-400/80 mb-2" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6 19c0 1.1.9 
2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm2.46-7.58c.32-.32.74-.5 1.18-.5s.86.18 1.18.5l3.58 3.58c.3.3.44.7.42 1.12.02.42-.12.82-.42 1.12L12.58 19c-.32.32-.74.5-1.18.5s-.86-.18-1.18-.5L6.64 15.34c-.32-.32-.5-.74-.5-1.18s.18-.86.5-1.18l3.58-3.58z"/></svg>
                                <span class="text-sm font-semibold text-gray-300/50">CONTEÚDO TEMPORÁRIO <%= i * 2 - 1 %></span>
                            </div>

                 
           <div class="p-4">
                                <h3 class="text-xl font-semibold mb-1 text-gray-100">Título do Vídeo Destaque</h3>
                                <p class="text-gray-400 text-sm">Nova entrevista da Atriz X sobre a produção.</p>
        
                    </div>
                        </div>
                    </div>

                    <div class="flex-shrink-0 w-80 snap-center">
             
           <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg shadow-gray-700/50 transform hover:scale-[1.03] transition duration-500 cursor-pointer">
                            
                            <div class="h-48 relative flex flex-col items-center justify-center 
                
                         bg-gray-700 border-b-2 border-orange-500 
                                         bg-gradient-to-t from-gray-800 to-gray-700">
                             
   <span class="absolute top-3 left-3 px-3 py-1 text-xs font-bold rounded-full bg-orange-600 text-white shadow-md">
                                    IMAGEM
                                </span>
                  
              <svg class="w-12 h-12 text-orange-500/80 mb-2" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM5 19l3-4 2 2 4-5 5 6H5z"/></svg>
                                <span class="text-sm font-semibold text-gray-300/50">CONTEÚDO TEMPORÁRIO <%= i * 2 %></span>
                 
           </div>

                            <div class="p-4">
                                <h3 class="text-xl font-semibold mb-1 text-gray-100">Galeria de Fotos Exclusiva</h3>
                     
           <p class="text-gray-400 text-sm">Os melhores momentos do ensaio fotográfico.</p>
                            </div>
                        </div>
                    </div>
          
      <% } %>
            </div>
            
            <button id="scroll-right" onclick="scrollCards('right')" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 p-3 bg-black/70 hover:bg-black/90 rounded-full shadow-2xl hidden md:block border border-orange-500/30">
                <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
       
     </button>

        </div>
    </section>

    <section id="atrizes" class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        <h2 class="text-4xl font-bold mb-10 text-center">
            Conheça as 
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-400 to-amber-300">
                Atrizes
     
       </span>
            Destaque
        </h2>

        <div class="relative max-w-7xl mx-auto overflow-hidden">
            
            <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-black via-black/80 to-transparent z-10 md:hidden"></div>
            
            <div class="grid 
grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-6 justify-items-center">
                
                <% if (actresses && actresses.length > 0) { %>
                    <% actresses.forEach((actress, i) => { %>
                        <a href="/atriz/<%= actress.slug %>" 
   
                        class="flex flex-col items-center group cursor-pointer 
                           <%= i >= 9 ?
'hidden lg:flex' : '' %> 
                           <%= i >= 6 && i < 9 ?
'opacity-50 md:opacity-100 transition duration-300 hover:opacity-100' : '' %>"> 
                            
                            <div class="w-20 h-20 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-full bg-gray-800 border-4 border-transparent group-hover:border-orange-500 transition duration-300 overflow-hidden flex items-center justify-center shadow-lg group-hover:shadow-orange-500/50">
                 
               <span class="text-xs font-bold text-gray-500">
                                    <img src="<%= actress.profilePhotoUrl %>" alt="<%= actress.name %>" class="w-full h-full object-cover">
                                </span>
     
                       </div>
                            <p class="mt-2 text-sm sm:text-lg font-semibold text-gray-200 group-hover:text-orange-400 transition duration-300 text-center">
                                <%= actress.name %>
      
                      </p>
                            <p class="text-xs text-gray-500">Conteúdo</p>
                        </a>
                    <% }) %>
  
                  <% } else { %>
                    <% for (let i = 0;
i < 6; i++) { %>
                        <div class="flex flex-col items-center opacity-50">
                            <div class="w-20 h-20 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-full bg-gray-800 border-4 border-dashed border-gray-600 flex items-center justify-center">
                         
       <span class="text-xs font-bold text-gray-500">VAZIO</span>
                            </div>
                            <p class="mt-2 text-sm sm:text-lg font-semibold text-gray-600 text-center">Atriz Vazia</p>
                           
 <p class="text-xs text-gray-700">0 Conteúdos</p>
                        </div>
                    <% } %>
                    <p class="text-center text-gray-400 col-span-full mt-4">Nenhuma atriz encontrada.
<a href="/admin/actresses/add" class="text-orange-400 hover:underline">Adicione uma no Admin.</a></p>
                <% } %>

            </div>
        </div>
        
        <div class="text-center -mt-12 md:mt-8 relative z-20"> 
            <a href="/todas-atrizes" class="inline-block px-10 py-3 text-lg font-bold rounded-lg transition-all duration-300 transform 
           
     bg-gray-800 hover:bg-orange-600 border border-orange-500/50 hover:border-orange-600 hover:text-white shadow-lg">
                Ver Todas as Atrizes
            </a>
        </div>
    </section>


<%- include('partials/footer.ejs') %>
    
    <style>
        /* Esconde a barra de rolagem horizontal */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
}
        .hide-scrollbar {
            -ms-overflow-style: none;
scrollbar-width: none;
        }

        /* Sombra no Texto (Text-Shadow) */
        .text-shadow {
            text-shadow: 0 0 5px rgba(0, 0, 0, 0.9), 0 0 10px rgba(0, 0, 0, 0.5);
}
    </style>
    
    <script>
        // 2. Script para Funcionalidade de Rolagem dos Cards (Setas)
        const slider = document.getElementById('card-slider');
const scrollDistance = 330; 

        function scrollCards(direction) {
            if (slider) {
                if (direction === 'left') {
                    slider.scrollBy({
                        left: -scrollDistance,
               
         behavior: 'smooth'
                    });
} else if (direction === 'right') {
                    slider.scrollBy({
                        left: scrollDistance,
                        behavior: 'smooth'
                    });
}
            }
        }

        // 3. Script para Desaparecer o Indicador de Rolagem (Horizontal)
        const horizontalIndicator = document.getElementById('scroll-indicator');
const previewSection = document.getElementById('previews');

        if (horizontalIndicator && previewSection && window.innerWidth < 768) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        horizontalIndicator.style.opacity = '1';
    
                    setTimeout(() => {
                            horizontalIndicator.style.opacity = '0';
                            setTimeout(() => {
                  
              horizontalIndicator.remove();
                            }, 500); 
                        }, 5000); 
                        observer.unobserve(previewSection);
      
              }
                });
            }, {
                threshold: 0.1
            });
observer.observe(previewSection);
        }
    </script>
    
</body>
</html>