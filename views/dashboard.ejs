<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-black text-white min-h-screen font-sans flex flex-col">
    
<%- include('partials/header.ejs', { user: user }) %>

    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
        <div class="bg-gray-900 p-8 rounded-xl shadow-xl border-t-4 border-orange-500">
            <h1 class="text-4xl font-black mb-2">Bem-vindo(a) à Minha Conta!</h1>
            
            <% if (user) { %>
                <p class="text-xl text-gray-300 mb-6">Olá, <span class="text-orange-400 font-semibold"><%= user.username %></span>.</p>
                
                <div class="space-y-4">
                    <p class="text-lg text-gray-200">Seu E-mail: <%= user.email %></p>
                    <p class="text-lg text-gray-200">Status: 
                        <% if (user.isPremium) { %>
                            <span class="px-3 py-1 text-sm font-bold rounded-full bg-amber-500 text-black">MEMBRO PREMIUM</span>
                        <% } else { %>
                            <span class="px-3 py-1 text-sm font-bold rounded-full bg-gray-600 text-white">BÁSICO</span>
                        <% } %>
                    </p>
                </div>

                <div class="mt-8 border-b border-gray-700">
                    <nav class="-mb-px flex space-x-8">
                        <button id="tab-actions" onclick="switchDashboardTab('actions')" class="py-4 px-1 border-b-2 border-orange-500 font-medium text-orange-400">Minha Conta</button>
                        <button id="tab-favorites" onclick="switchDashboardTab('favorites')" class="py-4 px-1 border-b-2 border-transparent font-medium text-gray-400 hover:text-gray-300">Meus Favoritos</button>
                    </nav>
                </div>

                <div id="content-actions" class="mt-6 pt-6">
                    <h2 class="text-2xl font-bold mb-4 text-orange-400">Ações Rápidas</h2>
                    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
                        <a href="/upgrade" class="px-6 py-3 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition shadow-lg shadow-orange-500/50 text-center">
                            Fazer Upgrade para Premium
                        </a>
                        <a href="/settings" class="px-6 py-3 text-md font-bold rounded-lg bg-gray-700 hover:bg-gray-600 transition text-center">
                            Configurações da Conta
                        </a>
                    </div>
                </div>

                <div id="content-favorites" class="mt-6 pt-6 hidden">
                    <h2 class="text-2xl font-bold mb-4 text-orange-400">Atrizes Favoritas</h2>
                    <% if (favoriteActresses && favoriteActresses.length > 0) { %>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                            <% favoriteActresses.forEach(actress => { %>
                                <a href="/atriz/<%= actress.slug %>" class="bg-gray-800 rounded-xl overflow-hidden shadow-lg transform hover:scale-105 transition border border-gray-700">
                                    <img src="<%= actress.profilePhotoUrl %>" class="w-full h-32 object-cover">
                                    <div class="p-4 text-center">
                                        <h3 class="font-bold text-gray-200"><%= actress.name %></h3>
                                    </div>
                                </a>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500 mb-8 italic">Você ainda não adicionou atrizes aos favoritos.</p>
                    <% } %>

                    <h2 class="text-2xl font-bold mb-4 text-orange-400">Conteúdos Favoritos</h2>
                    <% if (favoriteContents && favoriteContents.length > 0) { %>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <% favoriteContents.forEach(content => { %>
                                <div class="bg-gray-800 rounded-xl overflow-hidden shadow-lg border border-gray-700 relative">
                                    <span class="absolute top-2 left-2 z-10 px-2 py-1 text-[10px] font-bold rounded bg-black/70 text-white uppercase"><%= content.accessLevel %></span>
                                    <img src="<%= content.thumbnailPath || '/img/default-video-thumb.jpg' %>" class="w-full h-24 object-cover opacity-80">
                                    <div class="p-3">
                                        <h3 class="text-sm font-bold text-gray-200 truncate"><%= content.title %></h3>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500 italic">Você ainda não adicionou vídeos aos favoritos.</p>
                    <% } %>
                </div>

            <% } else { %>
                <p class="text-xl text-red-400">Você precisa estar logado para acessar este painel.</p>
                <a href="/login" class="mt-4 inline-block px-6 py-3 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition">
                    Ir para Login
                </a>
            <% } %>
        </div>
    </main>

<%- include('partials/footer.ejs') %>

<script>
function switchDashboardTab(tab) {
    document.getElementById('content-actions').classList.add('hidden');
    document.getElementById('content-favorites').classList.add('hidden');
    document.getElementById('tab-actions').classList.remove('border-orange-500', 'text-orange-400');
    document.getElementById('tab-actions').classList.add('border-transparent', 'text-gray-400');
    document.getElementById('tab-favorites').classList.remove('border-orange-500', 'text-orange-400');
    document.getElementById('tab-favorites').classList.add('border-transparent', 'text-gray-400');

    document.getElementById('content-' + tab).classList.remove('hidden');
    document.getElementById('tab-' + tab).classList.remove('border-transparent', 'text-gray-400');
    document.getElementById('tab-' + tab).classList.add('border-orange-500', 'text-orange-400');
}
</script>

</body>
</html>