
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-black text-white min-h-screen font-sans flex flex-col">
    
<%- include('partials/header.ejs', { user: user }) %>

    <main class="container mx-auto px-4 sm:px-6 
 lg:px-8 py-12 flex-grow">
        
        <div class="bg-gray-900 p-8 rounded-xl shadow-xl border-t-4 border-orange-500">
            <h1 class="text-4xl font-black mb-2">Bem-vindo(a) à Minha Conta!</h1>
            
            <% if (user) { %>
                <p class="text-xl text-gray-300 mb-6">Olá, <span class="text-orange-400 font-semibold"><%= user.username %></span>.
 Aqui você pode gerenciar sua conta e acessar seus benefícios.</p>
                
                <div class="space-y-4">
                    <p class="text-lg text-gray-200">Seu E-mail: <%= user.email %></p>
                    <p class="text-lg text-gray-200">Status: 
         
                <% if (user.isPremium) { %>
                            <span class="px-3 py-1 text-sm font-bold rounded-full bg-amber-500 text-black">MEMBRO PREMIUM</span>
                        <% } else { %>
                 
            <span class="px-3 py-1 text-sm font-bold rounded-full bg-gray-600 text-white">BÁSICO</span>
                        <% } %>
                    </p>
                </div>

                <div class="mt-8 pt-6 border-t 
 border-gray-700">
                    <h2 class="text-2xl font-bold mb-4 text-orange-400">Ações Rápidas</h2>
                    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
                        <a href="/upgrade" class="px-6 py-3 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition shadow-lg shadow-orange-500/50 text-center">
             
                 Fazer Upgrade para Premium
                        </a>
                        <a href="/settings" class="px-6 py-3 text-md font-bold rounded-lg bg-gray-700 hover:bg-gray-600 transition text-center">
                        
             Configurações da Conta
                        </a>
                    </div>
                </div>

            <% } else { %>
                 <p 
 class="text-xl text-red-400">Você precisa estar logado para acessar este painel.</p>
                 <a href="/login" class="mt-4 inline-block px-6 py-3 text-md font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition">
                    Ir para Login
                </a>
            <% } %>
        </div>

    
 </main>

<%- include('partials/footer.ejs') %>

</body>
</html>