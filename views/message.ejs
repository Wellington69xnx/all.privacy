<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-950 text-white min-h-screen font-sans flex items-center justify-center p-4">

    <div class="w-full max-w-md bg-gray-900 p-8 md:p-10 rounded-xl shadow-2xl border border-orange-500/20 text-center">
        <h1 class="text-3xl font-black mb-4">
             <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-500 to-amber-400">
                <%= title %>
            </span>
        </h1>
        <p class="text-lg text-gray-300 mb-8"><%= message %></p>
        
        <a href="/login" class="inline-block py-2 px-6 text-sm font-bold rounded-lg bg-orange-600 hover:bg-orange-700 transition duration-300">
            Ir para Login
        </a>
    </div>

</body>
</html>